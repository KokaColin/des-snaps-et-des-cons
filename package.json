{
  "name": "des-snaps-et-des-cons",
  "version": "0.3.0",
  "private": true,
  "description": "Party game multijoueur du Groupe des 7 : des photos, des légendes, des notes sur 22.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "check": "tsc -p tsconfig.worker.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^22.20.7",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
